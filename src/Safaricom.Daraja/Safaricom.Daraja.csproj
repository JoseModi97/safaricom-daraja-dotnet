<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings Condition="'$(TargetFramework)' != 'netstandard2.0'">enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Package Metadata adhering to Microsoft Package Authoring Best Practices -->
    <PackageId>Safaricom.Daraja</PackageId>
    <Version>0.1.0</Version>
    <Authors>Modi97, Jose Modi</Authors>
    <Company>Modi97</Company>
    <Copyright>Copyright (c) 2026 Jose Modi</Copyright>
    <Description>Idiomatic .NET SDK for Safaricom's Daraja API: OAuth2, M-Pesa Express (STK Push), C2B, B2C, B2B, Reversal, Transaction Status, Account Balance, M-Pesa Ratiba (standing orders), Lipa na Bonga, Pull Transactions API, Dynamic QR Code, Bill Manager, and Tax Remittance. First-class Sandbox/Production environment switching.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JoseModi97/safaricom-daraja-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/safaricom-daraja-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>safaricom;daraja;mpesa;stkpush;b2c;b2b;c2b;paybill;buygoods;reversal;ratiba;billmanager;dynamicqr;taxremittance;kenya;payments</PackageTags>
    <PackageReleaseNotes>0.1.0: Initial preview release of the core Daraja client (OAuth, STK Push, C2B, B2C, B2B, Reversal, Transaction Status, Account Balance, Ratiba, Lipa na Bonga, Pull API, Dynamic QR, Bill Manager, Tax Remittance).</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source Link & Debug Symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
